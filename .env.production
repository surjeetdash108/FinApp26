# STAGE production build config (this is the `stage` branch's .env.production —
# Next.js loads this file for every `next build` regardless of branch name).
#
# Firebase client config for the STAGE project (market-catalyst-stage), so
# staging authenticates its own users against its own project instead of prod's
# market-catalyst-502415. Fetched via:
#   firebase apps:sdkconfig WEB <appId> --project market-catalyst-stage
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBWkfGmG077Zo9vYCBTyxh27si1RM23EkQ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=market-catalyst-stage.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=market-catalyst-stage
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=market-catalyst-stage.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=523639228835
NEXT_PUBLIC_FIREBASE_APP_ID=1:523639228835:web:247768e9e0077907eb3216
# No measurementId — Analytics not yet enabled on the stage web app.

# Stage backend URL: NOT SET — the stage Cloud Run "live" service has not been
# deployed yet (per 2026-07-27 discussion). Until it is, this falls back to
# http://localhost:4100 (see app/iq/backend.ts) — fine for local dev against
# stage Firebase, but a staging BUILD deployed to stg.app.marketcatalyst.ai
# will not reach a real backend until this is set to the stage live-service URL
# (or its custom domain, e.g. https://stg.api.marketcatalyst.ai) once deployed.
# NEXT_PUBLIC_BACKEND_URL=

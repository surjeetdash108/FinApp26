# Production build config. Read by app/iq/backend.ts (NEXT_PUBLIC_BACKEND_URL)
# and baked into the bundle at BUILD time (Next.js inlines NEXT_PUBLIC_* vars),
# not read at runtime — so a build without this value silently falls back to
# http://localhost:4100 (see backend.ts). This file exists so that can't happen
# on the prod branch: `npm run build` here always targets the prod backend.
#
# market-catalyst-live — the public APP_ROLE=live Cloud Run service in project
# market-catalyst-502415 (see MarketCatalystBackEnd/deploy/DEPLOY.md §3b).
NEXT_PUBLIC_BACKEND_URL=https://market-catalyst-live-741318166823.us-central1.run.app

# Firebase client config for the PROD project. Explicit here (matching
# app/firebase.ts's fallback values exactly) so prod is self-documenting via
# its own env file, the same pattern used for the staging branch's
# .env.production — rather than relying silently on the in-code fallback.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDVjZmJ11qzbPIvruwOHiTiMWvjTcUmhuk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=market-catalyst-502415.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=market-catalyst-502415
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=market-catalyst-502415.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=741318166823
NEXT_PUBLIC_FIREBASE_APP_ID=1:741318166823:web:e7bdefb314ecd446494102
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-NFPTC0K6Z0

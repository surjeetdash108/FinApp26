NEXT_PUBLIC_SENTRY_DSN=

# market-catalyst-backend "live" service — on-demand bars/company/search and
# the ticker-tape SSE stream. Local dev: http://localhost:4100 (the backend's
# default worker port also mounts LiveModule). Production: the
# market-catalyst-live Cloud Run URL (see backend deploy/DEPLOY.md §3b). Do
# NOT point this at the worker's private URL in production — that service is
# --no-allow-unauthenticated and CORS-restricted to the live service's origin.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4100
